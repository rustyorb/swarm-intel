# Swarm Intel server configuration.
# Copy this file to .env and fill in the keys for the providers you use.
# Keys set here are server-side fallbacks: if the browser Settings panel has
# a key for a provider it wins, otherwise the .env value is used. Keys in
# .env survive port changes and browser data clears; keys entered in the
# browser are stored per-origin (host:port) in localStorage.

# Provider API keys (set only the ones you use)
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
VENICE_API_KEY=""

# Local inference endpoints (defaults shown; override if yours differ)
# LMSTUDIO_BASE_URL="http://localhost:1234/v1"
# OLLAMA_BASE_URL="http://localhost:11434"

# Server port. The server starts probing here and walks upward if the port
# is already serving something (e.g. Docker containers).
# PORT=3369
